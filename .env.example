# Use the base URL of your OpenAI-compatible provider, including /v1 if required.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# Optional search services for GAIA.
SERPER_API_KEY=
TAVILY_API_KEY=

# Set the rates used for cost accounting, in your chosen currency.
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0
LLM_PRICE_CURRENCY=CNY

# Evoteam runtime (OpenAI-compatible provider)
LLM_PROVIDER=dev
DEV_API_BASE=https://example.invalid/v1
DEV_API_KEY=replace-me
META_TEAM_MODEL=deepseek-chat
TEAM_SELECTOR_MODEL=deepseek-chat
TEAM_REFLECTION_MODEL=deepseek-chat

# Optional override for the pinned runtime (default: external/EvoTeam)
EVOTEAM_ROOT=

# Export dataset paths in your shell before launching (see methods/Evoteam/README.md).
# GAIA_DATA_DIR, MAC_BENCH_ROOT, MASBENCH_ROOT, MASBENCH_SPLIT_DIR
