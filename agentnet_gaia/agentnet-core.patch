@@ -50,0 +51,5 @@
+        # Hard cap on router/executor rounds for ONE task. Without it an unparsable
+        # router decision (e.g. finish_reason=length truncating the DECISION line)
+        # makes the loop below spin forever. Worst legitimate chain is
+        # forward_path_max_length forwards + max_execution_times split rounds.
+        self.max_router_rounds = int(experiment_config.get("max_router_rounds", 24))
@@ -94,0 +100,2 @@
+        router_rounds = 0
+        last_decision = None
@@ -95,0 +103,5 @@
+            router_rounds += 1
+            if router_rounds > self.max_router_rounds:
+                raise RuntimeError(
+                    f"router did not converge after {self.max_router_rounds} rounds "
+                    f"(task {task_chain.task_chain_id}, last decision={last_decision!r})")
@@ -114,2 +126,12 @@
-            
-            
+            last_decision = decision
+
+            if decision not in ("forward", "execute", "split"):
+                # Unusable router output (usually max_tokens truncation -> empty DECISION).
+                # Executing is the safe fallback; re-asking the same agent just loops.
+                logger.warning(
+                    f"Agent {current_agent.agent_id} returned an unusable router decision "
+                    f"{decision!r} for Task {task_chain.get_current_task_id()}; falling back to execute")
+                decision = "execute"
+                if not (description or "").strip():
+                    description = task_chain.major_problem
+
