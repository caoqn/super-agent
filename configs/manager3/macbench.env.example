# Copy this file to configs/manager3/macbench.env and fill in local values.
# The checkout must contain src/mac_bench, data/tasks.json, task bundles, and
# configs/evaluation/task_budgets.json.
MAC_BENCH_HOST_ROOT=/absolute/path/to/MAC_Bench-main
MAC_BENCH_ROOT=/absolute/path/to/MAC_Bench-main
MAC_BENCH_SPLIT=test

# OpenAI-compatible endpoint used by all four agents.
MAC_BENCH_LLM_BASE_URL=https://api.openai.com/v1
MAC_BENCH_LLM_API_KEY=
MAC_BENCH_LLM_MODEL=
MAC_BENCH_LLM_TIMEOUT_SECONDS=180
MAC_BENCH_LLM_MAX_RETRIES=0
MAC_BENCH_LLM_THINKING=disabled
MAC_BENCH_MAX_OUTPUT_TOKENS=32768

# Optional per-task overrides. Leave empty to use the official budget table.
MAC_BENCH_MAX_MODEL_CALLS=
MAC_BENCH_MAX_TOOL_CALLS=
MAC_BENCH_MAX_TOKENS=
MAC_BENCH_TASK_TIMEOUT_S=

# MAC-Bench environment provider. Modal credentials are passed through to the
# container by Compose; keep them empty here unless this file is local-only.
MAC_BENCH_SANDBOX_BACKEND=modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
