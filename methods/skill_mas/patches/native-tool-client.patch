+    async def generate_with_tools(
+        self,
+        *,
+        user_prompt: str,
+        tools: list[dict[str, Any]],
+        messages: list[dict[str, Any]] | None = None,
+        system_prompt: str = "",
+        **create_kwargs: Any,
+    ) -> tuple[str, list[dict[str, Any]], dict[str, Any]]:
+        """Run one OpenAI-compatible tool-call turn.
+
+        The normal ``generate`` path deliberately returns text only because
+        Skill-MAS planning does not use tools. Native benchmark execution
+        needs the raw function calls, so this small opt-in method exposes them
+        without changing the existing planner/text API.
+        """
+        msg_list = list(messages or [])
+        if not msg_list:
+            if system_prompt:
+                msg_list.append({"role": "system", "content": system_prompt})
+            msg_list.append({"role": "user", "content": user_prompt})
+        kwargs: dict[str, Any] = {
+            "model": self.model,
+            "messages": msg_list,
+            "tools": tools,
+            "tool_choice": create_kwargs.pop("tool_choice", "auto"),
+            "temperature": self.temperature,
+            "max_tokens": self.max_tokens,
+            **({"reasoning_effort": self.reasoning_effort} if self.reasoning_effort else {}),
+            **create_kwargs,
+        }
+        merged_extra: dict[str, Any] = dict(self.extra_body or {})
+        call_extra = kwargs.pop("extra_body", None)
+        if isinstance(call_extra, dict):
+            merged_extra.update(call_extra)
+        if merged_extra:
+            kwargs["extra_body"] = merged_extra
+        response = await self.client.chat.completions.create(**kwargs)
+        msg = response.choices[0].message
+        text = structured_json_candidate_text(msg)
+        calls: list[dict[str, Any]] = []
+        for call in list(getattr(msg, "tool_calls", None) or []):
+            fn = getattr(call, "function", None)
+            calls.append({
+                "id": str(getattr(call, "id", "")),
+                "name": str(getattr(fn, "name", "")),
+                "arguments": str(getattr(fn, "arguments", "{}")),
+            })
+        usage = enrich_usage_with_cost(_usage_dict_from_chat_completion(response), model=self.model, table=self.pricing)
+        return text, calls, usage
+
