+def _bounded_text(value: Any, limit: int = _EVIDENCE_TEXT_MAX_CHARS) -> str:
+    text = str(value or "").strip()
+    if len(text) <= limit:
+        return text
+    head = max(1, limit * 2 // 3)
+    tail = max(1, limit - head)
+    return f"{text[:head]}\n[...compressed...]\n{text[-tail:]}"
+
+
+def compress_retained_evidence(raw_view: Any, *, record: Any) -> dict[str, Any]:
+    """Approximate the paper's Retain(T) contract for optimizer prompts.
+
+    This is deliberately evidence-oriented rather than a raw trace dump:
+    retain outcome, failure/near-miss signals, stage decisions, verification,
+    and compact tool evidence; omit full generated code and repeated logs.
+    """
+    view = raw_view if isinstance(raw_view, dict) else {}
+    score = float(getattr(record, "score", 0.0) or 0.0)
+    success = view.get("success")
+    if success is None:
+        success = score > 0.0
+    failure_stage = str(view.get("failure_stage") or "").strip()
+    failure_reason = _bounded_text(view.get("failure_reason"))
+    timed_out = failure_stage == "task_timeout" or view.get("completion_status") == "completed_timeout"
+    stages = view.get("skill_mas_build_stages")
+    compact_stages: list[dict[str, Any]] = []
+    if isinstance(stages, list):
+        for item in stages[:3]:
+            if not isinstance(item, dict):
+                continue
+            compact_stages.append(
+                {
+                    "stage": item.get("stage") or item.get("stage_name"),
+                    "instruction": _bounded_text(item.get("instruction"), 500),
+                    "output": _bounded_text(item.get("output_preview") or item.get("output"), 900),
+                }
+            )
+    tool_summary = view.get("native_tool_trace_summary") or view.get("tool_trace_summary")
+    evaluation = view.get("evaluation") if isinstance(view.get("evaluation"), dict) else {}
+    final_output = _bounded_text(view.get("final_output"), 1_000)
+    if timed_out:
+        evidence_class = "timeout"
+    elif not bool(success) and (compact_stages or tool_summary or final_output):
+        evidence_class = "diagnosable_failure_or_near_miss"
+    elif bool(success) and (compact_stages or tool_summary):
+        evidence_class = "reusable_success"
+    else:
+        evidence_class = "ordinary_outcome"
+    evidence = {
+        "schema": SCHEMA_RETAINED_EVIDENCE,
+        "task_id": str(view.get("task_id") or getattr(record, "task_id", "")),
+        "bench_backend": str(view.get("bench_backend") or getattr(record, "bench_backend", "")),
+        "score": score,
+        "success": bool(success),
+        "evidence_class": evidence_class,
+        "failure_stage": failure_stage or None,
+        "failure_reason": failure_reason or None,
+        "task_description": _bounded_text(view.get("task_description"), 1_500),
+        "stages": compact_stages,
+        "tool_trace_summary": tool_summary,
+        "evaluation": {
+            k: evaluation.get(k)
+            for k in ("success", "score", "summary", "details")
+            if k in evaluation
+        },
+        "final_output": final_output,
+        "compression_policy": "retained_outcome_failure_nearmiss_reusable_success_stage_evidence",
+    }
+    encoded = json.dumps(evidence, ensure_ascii=False, default=str)
+    if len(encoded) > _RETAINED_EVIDENCE_MAX_CHARS:
+        evidence["task_description"] = _bounded_text(evidence["task_description"], 700)
+        evidence["final_output"] = _bounded_text(evidence["final_output"], 500)
+        evidence["stages"] = evidence["stages"][:2]
+        evidence["tool_trace_summary"] = None
+    return evidence
+
