+        skills_evolution_dir / bench_id / run_id / f"round_{round_idx:02d}" / "SKILL.md"
+    )
+    if not skill_path.is_file():
+        raise FileNotFoundError(f"Skill workspace missing SKILL.md: {skill_path}")
