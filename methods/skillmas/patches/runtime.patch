+    stages = _trim_build_stage_traces(raw_stages)
+    mas_code = raw.get("mas_code")
+    evaluation = raw.get("evaluation")
+    if not isinstance(evaluation, dict):
+        evaluation = {}
+    else:
+        evaluation = copy.deepcopy(evaluation)
+
+    out: dict[str, Any] = {
+        "schema": SCHEMA_EVOLUTION_VIEW,
+        "bench_backend": str(raw.get("bench_backend") or getattr(record, "bench_backend", "")),
+        "task_id": str(raw.get("task_id") or getattr(record, "task_id", "")),
+        "split": raw.get("split"),
+        "task_description": task_description,
+        "score_record": {
+            "score": float(getattr(record, "score", 0.0)),
+            "score_source": getattr(record, "score_source", ""),
+        },
+        "success": raw.get("success"),
+        "failure_stage": raw.get("failure_stage"),
+        "failure_reason": raw.get("failure_reason"),
+        "evaluation": evaluation,
+        "final_output": raw.get("final_output"),
+        "skill_mas_build_stages": stages,
+        "native_tool_trace_summary": summarize_native_trace(raw.get("native_tool_trace")),
+        "usage_totals": copy.deepcopy(raw.get("usage_totals"))
+        if isinstance(raw.get("usage_totals"), dict)
+        else None,
+    }
+
+    if isinstance(mas_code, str) and mas_code.strip():
+        out["mas_code"] = _mas_code_forward_async_only(mas_code)
+
+    for key in (
+        "elapsed_seconds",
+        "effective_elapsed_seconds",
+        "effective_budget_seconds",
+        "api_recovery_window_seconds",
+        "api_recovery_excluded_seconds",
+    ):
+        if key in raw:
+            out[key] = raw.get(key)
+    return out
